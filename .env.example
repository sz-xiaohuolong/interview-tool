# 复制为 .env.local；配置只由后端读取。
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
# 支持推理的模型可设为 high；留空使用服务端默认值。
LLM_REASONING_EFFORT=
# 本地无密钥体验时显式改为 mock；界面和报告均标识测试模式。
# LLM_PROVIDER=mock

# 专项训练仅在所选资料库已显式准备结构后开启，不用于版本灰度。
TRAINING_ENABLED=false
# 可选：单独指定综合面试的追问模型和思考强度；留空模型则沿用全站模型。
INTERVIEW_FOLLOWUP_MODEL=
INTERVIEW_FOLLOWUP_REASONING_EFFORT=low
